# Copy to .env and fill in. NEVER commit .env. Placeholder values only here.

# Global
# NB: cost-control thresholds are contract, not environment — the enrichment gate
# (0.85, Hard Rule 2) and the daily email cap (5, Hard Rule 3) live in code as
# constants, NOT here. See docs/DECISIONS.md ADR-004.
DRY_RUN=true
DATABASE_PATH=data/intent_pipeline.db
