# Layer 1 - Ingestion (Adzuna uses a paired app id + app key)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Layer 2.5 - Enrichment (F2: mock through V1; real provider gated behind paid plan)
APOLLO_API_KEY=

# Layer 4 - Orchestrator
ANTHROPIC_API_KEY=
