# Python
__pycache__/
*.py[cod]
*.egg-info/

# Test / lint / tooling caches
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Secrets — NEVER commit
.env

# SQLite database (lives under data/, keep the dir via .gitkeep)
data/*.db

# OS / editor cruft
.DS_Store
.idea/
.vscode/

# Local-only project documents — governance, planning, and the issues/ backlog stay on
# the owner's disk, not in the repo (ADR-010). The only tracked docs are CLAUDE.md (the
# agent's constitution) and README.md (Definition of Done §4: clean-clone quickstart).
/docs/
/issues/

# Per-session learning primers/debriefs — disposable scaffolding for the concept
# vault, not project truth. Sessions are independent; repeats are expected.
learning/

# Claude Code / agent artifacts — local only ("anything related to claude")
.claude/
CLAUDE.local.md
.claude.json
.mcp.json
